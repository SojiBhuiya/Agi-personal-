<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:text="@string/welcome_title"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Body" android:textColor="@color/text_muted" android:layout_marginTop="6dp" android:text="@string/welcome_body"/>
    <TextView android:id="@+id/welcomeExamples" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Body" android:layout_marginTop="10dp" android:lineSpacingExtra="6dp"/>
</LinearLayout>
