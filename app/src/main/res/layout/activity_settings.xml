<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:text="AI provider"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="4dp" android:text="Keys are encrypted with the Android Keystore and stored only on this phone. Nothing is hard-coded in the app."/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:text="Preset"/>
            <Spinner android:id="@+id/preset" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:popupBackground="@color/surface_2"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="14dp" android:text="Provider type"/>
            <Spinner android:id="@+id/providerType" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:popupBackground="@color/surface_2"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="14dp" android:text="Base URL"/>
            <EditText android:id="@+id/baseUrl" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:inputType="textUri" android:textSize="14sp" android:textColor="@color/text" android:hint="https://api.groq.com/openai/v1"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="14dp" android:text="Model"/>
            <EditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:inputType="text" android:textSize="14sp" android:textColor="@color/text" android:hint="llama-3.3-70b-versatile"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="14dp" android:text="API key"/>
            <EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:inputType="textPassword" android:textSize="14sp" android:textColor="@color/text" android:hint="Paste key (stored encrypted)"/>
            <TextView android:id="@+id/presetNote" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="8dp"/>

            <Button android:id="@+id/btnTest" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="14dp" style="@style/Button.Ghost" android:text="Test connection"/>
            <TextView android:id="@+id/testResult" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:layout_marginTop="24dp" android:text="Behaviour"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card">
            <Switch android:id="@+id/swFallback" android:layout_width="match_parent" android:layout_height="52dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="@color/text" android:text="Fall back to offline planner if the AI API fails"/>
            <Switch android:id="@+id/swSpeak" android:layout_width="match_parent" android:layout_height="52dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="@color/text" android:text="Speak replies aloud"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:layout_marginTop="24dp" android:text="Updates"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card">
            <TextView android:id="@+id/updateInstalled" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Body"/>
            <TextView android:id="@+id/updateStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="6dp" android:text="Updates are fetched from GitHub Releases (SojiBhuiya/Agi-personal-)."/>
            <TextView android:id="@+id/updateNotes" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="8dp" android:maxLines="8" android:ellipsize="end" android:visibility="gone"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btnCheckUpdate" android:layout_width="wrap_content" android:layout_height="44dp" style="@style/Button.Ghost" android:text="Check for updates"/>
                <Button android:id="@+id/btnViewRelease" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" style="@style/Button.Primary" android:text="View release" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" style="@style/Button.Primary" android:text="Save"/>
        <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="16dp" android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</ScrollView>
